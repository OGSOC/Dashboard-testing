# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://stockdash:stockdash@localhost:5432/stockdash

# ── Session / auth ───────────────────────────────────────────────────────
# The app is single-user. This account is created automatically on `npm run db:seed`.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── External data providers (all optional — the app runs on seed/sample
#    data for any provider whose key is left blank) ────────────────────────

# Finnhub — news, insider transactions, quotes. Free tier, no credit card.
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage — dividend calendar/history. Free tier, no credit card.
# Sign up: https://www.alphavantage.co/support/#api-key
# NOTE: free tier is limited to ~25 requests/day, so dividend data refreshes
# a few tickers per day rather than all at once.
ALPHA_VANTAGE_API_KEY=

# SEC EDGAR — 13F institutional ("whale") filings. No key required, but the
# SEC's fair-access policy asks every caller to identify itself with a
# contact string in the User-Agent header. Put a real email here.
SEC_EDGAR_CONTACT_EMAIL=you@example.com

# House Stock Watcher / Senate Stock Watcher — congressional trading.
# Public JSON, no key required, nothing to configure here.
